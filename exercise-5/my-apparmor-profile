#include <tunables/global>

profile my-apparmor-profile flags=(attach_disconnected,mediate_deleted) {
    #include <abstractions/base>

    file,
    network,
    capability,

    deny /etc/passwd r,
    deny /etc/shadow r,
    deny /var/** w,

    deny /bin/bash mx,
    deny /usr/bin/bash mx,

    deny capability sys_admin,
    deny mount,
}